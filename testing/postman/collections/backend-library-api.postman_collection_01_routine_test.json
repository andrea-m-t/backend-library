                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Log error message when not 200', function () {",
                  "    if (pm.response.code !== 200) {",
                  "        let body;",
                  "        try {",
                  "            body = pm.response.json();",
                  "        } catch (e) {",
                  "            console.log('Non-JSON response body', pm.response.text());",
                  "            return;",
                  "        }",
                  "        if (body && body.error) {",
                  "            console.log('API error message:', body.error);",
                  "        } else {",
                  "            console.log('Unexpected error response body:', body);",
                  "        }",
